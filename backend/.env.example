# ManganEX Backend Environment Variables (Example)
# Copy this file to .env and configure appropriately for deployment

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production # set to 'development' for local dev

# ML Model Configuration
# MODEL_DIR=../models

# Optional: Copernicus / Sentinel-2 Credentials (If using auto-downloads)
# COPERNICUS_USER=
# COPERNICUS_PASS=

# Optional: Data Directory Override
# DATA_DIR=../data
